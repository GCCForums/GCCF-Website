# =================================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# =================================================================
DATABASE_URL=postgresql://user:password@host:6543/postgres

SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-key

# =================================================================
# AUTH / SECURITY
# =================================================================
# Generate a cryptographically strong 256-bit secret key for signing JWTs
# Example command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Initial super admin credentials (used only on initial database seed)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=your_strong_admin_password_here

# Enable schema auto-sync (MUST BE false in production!)
DB_SYNCHRONIZE=false

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# =================================================================
# EMAIL CONFIGURATION (SMTP)
# =================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Global Cybersecurity Community Forum <no-reply@example.com>"

# =================================================================
# CLOUDINARY IMAGE STORAGE
# =================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
