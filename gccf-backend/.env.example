# =================================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# =================================================================
# Option 1 (Recommended for Supabase): Single Connection String (URI)
# Find this in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# - For Supavisor Connection Pooler (Recommended for serverless / pooled queries, port 6543):
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# - For Direct connection (port 5432):
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Option 2: Discrete Connection Parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gccf_db
# Set DB_SSL=true when connecting directly to Supabase with discrete parameters
DB_SSL=false
# Auto-sync schema (set to false in production if using migrations)
DB_SYNCHRONIZE=true

# =================================================================
# SUPABASE API & STORAGE CONFIGURATION (Optional / Ready for SDK)
# =================================================================
# Find in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =================================================================
# AUTH / SECURITY
# =================================================================
JWT_SECRET=gccf-secret-key-change-in-production

# =================================================================
# EMAIL CONFIGURATION (SMTP - HOSTINGER)
# =================================================================
# For Hostinger:
# SMTP Host: smtp.hostinger.com
# Port 465 (SSL - Recommended) or Port 587 (TLS/STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=web@gccf.org
SMTP_PASS=your-hostinger-email-password
SMTP_FROM="Global Cybersecurity Community Forum <info@gccf.org>"